{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palacios-web-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "api.palacioscpa.com", "custom_domain": true }],
  "vars": {
    "FRONTEND_ORIGINS": "https://palacioscpa.com,https://www.palacioscpa.com",
    "ENABLE_SWAGGER": "false",
  },
  "dev": {
    "port": 3000,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "palacios-web-api",
      "database_id": "544bd717-892d-4dab-aaf0-c194ebc65534",
      // Keep the existing local SQLite database.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "ratelimits": [
    {
      "name": "BUSINESS_PROFILE_RATE_LIMITER",
      "namespace_id": "60100",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.png", "**/*.webp"],
      "fallthrough": true,
    },
  ],
}
