{
  "name": "palacios-web-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "API de perfiles empresariales de Palacios CPA en Cloudflare Workers.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "lint": "eslint src test drizzle.config.ts vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm check && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run test/business-profile.e2e.test.ts",
    "test:integration": "vitest run test/business-profile.integration.test.ts",
    "db:generate": "drizzle-kit generate --name",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "dev:mock": "wrangler dev test/fixtures/local-worker.ts --local --ip 127.0.0.1"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "hono": "^4.0.0",
    "resend": "^6.26.0",
    "validator": "^13.15.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "@types/validator": "^13.15.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.36.0"
  }
}
